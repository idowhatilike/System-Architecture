# ==============================================================================
# .gitignore - Systems Engineering (C++ / CMake / Debugging & Tracing)
# Project: low-cortisol
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build Artifacts & CMake
# ------------------------------------------------------------------------------
build/
bin/
out/
dist/
cmake-build-*/

# CMake Generated Files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# CMake User Presets (keep CMakePresets.json if shared with team)
CMakeUserPresets.json

# ------------------------------------------------------------------------------
# 2. Compiled Objects, Libraries & Binaries
# ------------------------------------------------------------------------------
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exe
*.out
*.app

# Precompiled Headers
*.gch
*.pch

# ------------------------------------------------------------------------------
# 3. Debugging, Symbols & MSVC Artifacts
# ------------------------------------------------------------------------------
*.pdb
*.ilk
*.idb
*.exp
*.dSYM/

# ------------------------------------------------------------------------------
# 4. Systems Profiling, Tracing & Crash Dumps
# ------------------------------------------------------------------------------
# Core Dumps & GDB
core
core.*
*.core
vgcore.*
.gdb_history

# Valgrind Outputs
valgrind*.log
valgrind*.txt
callgrind.out.*
massif.out.*

# Linux strace & ltrace logs
strace*.log
strace*.txt
ltrace*.log
ltrace*.txt

# Linux perf profiling
perf.data
perf.data.old
gmon.out

# Sanitizers (ASan, UBSan, TSan, MSan) logs
asan.log*
tsan.log*
ubsan.log*
msan.log*

# ------------------------------------------------------------------------------
# 5. IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.userosprovider
*.sln.docstates

# Visual Studio Code (Ignore local states, allow sharing configs if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# CLion & JetBrains
.idea/

# Sublime / Vim / Emacs
*.swp
*.swo
*~
.#*

# ------------------------------------------------------------------------------
# 6. Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini